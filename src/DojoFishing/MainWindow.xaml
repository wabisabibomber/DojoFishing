<Window x:Class="DojoFishing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DojoFishing"
        Title="DojoFishing" Icon="{DynamicResource ApplicationIcon}" Width="1008" Height="820" MinWidth="882" MinHeight="720"
        Background="#F2F5F9" FontFamily="Yu Gothic UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Background" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="387"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="Configuration" Margin="0,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ProcessSettingsRow"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="監視対象のプロセス"><StackPanel>
                        <TextBlock Text="検索キーワード"/>
                        <TextBox x:Name="ProcessFilter" Text="VRChat.exe" Margin="0,5,0,10" TextChanged="SearchChanged"/>
                        <TextBlock Text="対象プロセス"/>
                        <ComboBox x:Name="Processes" DisplayMemberPath="Label" DropDownOpened="ProcessDropDownOpened" Margin="0,5,0,6" MaxDropDownHeight="300"/>
                    </StackPanel></GroupBox>
                    <GroupBox Grid.Row="1" Header="検出感度"><StackPanel>
                        <DockPanel><TextBlock Text="検出閾値" VerticalAlignment="Center"/><TextBox x:Name="ThresholdText" Width="75" DockPanel.Dock="Right" Text="{Binding ElementName=Threshold, Path=Value, StringFormat=F2, UpdateSourceTrigger=LostFocus}" LostKeyboardFocus="SettingCommitted" PreviewKeyDown="SettingKeyDown"/></DockPanel>
                        <Slider x:Name="Threshold" Minimum="0.1" Maximum="1" Value="0.55" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="ThresholdChanged"/>
                        <TextBlock Text="値を高くすると検出条件が厳しくなります。" TextWrapping="Wrap" FontSize="12" Foreground="#52657C" Margin="0,8,0,0"/>
                    </StackPanel></GroupBox>
                    <GroupBox Grid.Row="2" Header="クリック設定"><StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="クリック間隔 (ms)"/><TextBox x:Name="Interval" Text="1800" LostKeyboardFocus="SettingCommitted" PreviewKeyDown="SettingKeyDown"/></StackPanel>
                            <StackPanel><TextBlock Text="緊急停止ホットキー"/><TextBox x:Name="Hotkey" Text="Ctrl+Alt+F10" LostKeyboardFocus="SettingCommitted" PreviewKeyDown="SettingKeyDown"/></StackPanel>
                        </UniformGrid>
                    </StackPanel></GroupBox>
                </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="ProcessSettingsRow"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <GroupBox Header="監視状態"><StackPanel>
                    <TextBlock x:Name="StateText" Text="停止" FontSize="24" FontWeight="SemiBold" Foreground="#153151"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="類似度スコア"/><TextBlock x:Name="ScoreText" Text="0.000" FontSize="34" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="検出回数"/><TextBlock x:Name="CountText" Text="0" FontSize="34" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                    <ProgressBar x:Name="LevelBar" Minimum="-100" Maximum="0" Value="-100" Height="8" Margin="0,8,0,6"/>
                    <TextBlock x:Name="MetricsText" Text="入力 — dBFS / 解析 — ms" FontFamily="Consolas" FontSize="12"/>
                </StackPanel></GroupBox>
                <GroupBox Grid.Row="1" Header="スコア履歴（直近約15秒 / 赤線：検出閾値）"><local:ScorePlot x:Name="Plot" MinHeight="120"/></GroupBox>
            </Grid>
        </Grid>
        <GroupBox Grid.Row="1" Header="イベントログ" Margin="0">
            <ListBox x:Name="EventLog" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>
        <Button Grid.Row="2" x:Name="MonitorButton" Content="監視開始" Click="ToggleMonitoring" Background="#194B79" Foreground="White" FontSize="18" FontWeight="SemiBold" Height="54" Margin="0,16,0,0" HorizontalAlignment="Stretch">
            <Button.Template><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Button.Template>
        </Button>
    </Grid>
</Window>
